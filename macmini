#!/usr/bin/env bash
# macmini —— 操作 macmini 的统一入口
#
# 用法：
#   macmini tmux              每次开一个新会话，名字自动递增（session#1、session#2 …）
#   macmini tmux -s <名字>    接上该名字的会话；没有就新建（断线重连用这条）
#   macmini tmux <名字>       同上，省略 -s 的写法
#   macmini tmux -a           接回最近一次进去过的会话（按最后一次 attach 的时间算）
#   macmini tmux -l           列出 macmini 上现有的 tmux 会话
#   macmini <其它命令...>     直接在 macmini 上跑（带终端），例如 macmini df -h
#   macmini -h                显示本帮助
#
# 背景：
#   * 传输层用 et（Eternal Terminal）而不是 ssh：et 有**本地回显**——按键先在本地显示、
#     再异步同步给远端，所以 40ms 延迟、250ms 尖峰都不会变成打字卡顿；断网 / 换网络
#     还会自动重连。tmux 仍然在远端跑，负责会话持久化、分屏、状态栏等体验。
#   * et 的 `--name` 每次都新建会话（同名也不接），所以要「先试 --attach 接回、失败再 --name 新建」。
#   * et 在 **本机 tmux 内不可用**（macOS 26 上会报 No route to host，原因未定位），
#     检测到 $TMUX 时自动回退到 ssh，保证在 tmux 里跑这条命令也能用。
#   * ssh 的 -t 负责分配终端，tmux 没有终端会报 "open terminal failed"（回退路径仍需要）。
#   * 远端的 -A 是 tmux 的「有就接上、没有就新建」，所以指定名字时一条命令兼顾首次进入与断线重连。
#   * 不带 -s 时不做「接回」，每次都是新会话：会话名按 session#1、session#2 递增，不用起名也不会撞名。
#   * 会话名里的 # 已经实测可用（本机 tmux 3.6b / macmini tmux 3.3a），不是特殊字符。
#   * macmini 已装好 Ghostty 的 terminfo，TERM=xterm-ghostty 不会再报 missing terminal。
set -u

HOST="${MACMINI_HOST:-mac-mini}"        # 换机器 / 换别名时用环境变量覆盖，如 MACMINI_HOST=mac-mini-lan macmini tmux
ET_USER="${MACMINI_ET_USER:-mac}"       # et 登录用的用户名（et 要写成 user@host）
PREFIX="session"        # 自动编号会话的前缀，最终名字形如 session#3

usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit "${1:-0}"
}

# 列出 macmini 上的会话名（一个也没有时输出为空）
remote_sessions() {
  ssh "$HOST" "tmux ls -F '#{session_name}'" 2>/dev/null
}

# 算下一个没被占用的名字：从 session#1 开始找，遇到缺口就用那个号
# （比如已有 session#1、session#3，就返回 session#2；删掉的号会被重新利用）
next_name() {
  local n
  n=$(remote_sessions \
        | sed -n "s/^${PREFIX}#\([0-9][0-9]*\)\$/\\1/p" \
        | sort -n \
        | awk 'BEGIN { n = 1 } $1 + 0 == n { n++ } END { print n }')
  printf '%s#%s\n' "$PREFIX" "${n:-1}"
}

# 找「最近一次进去过」的会话：优先看 session_last_attached（最后一次 attach 的时间，
# 也就是你最近一次进这个会话的时刻），从没 attach 过的（-d 在后台建的）才退而看 session_activity
# 注意：会话名里不要用 | 和制表符，否则这里解析会乱
recent_session() {
  ssh "$HOST" "tmux ls -F '#{session_last_attached}|#{session_activity}|#{session_name}'" 2>/dev/null \
    | awk -F'|' 'NF == 3 { print (($1 + 0) > 0 ? $1 : $2) "\t" $3 }' \
    | sort -rn \
    | head -1 \
    | cut -f2-
}

# 连上某个 tmux 会话（et 优先；在 tmux 里或 et 不存在时回退 ssh）
# et 的 --attach 失败时会把提示打到 stdout 且无法静默，所以会产生一行「No saved session」——
# 只会出现在「该 et 会话还不存在」（即首次连接 / 会话已过期）的时候，随后立刻正常连上。
connect() {
  local name="$1"
  local remote_cmd="exec tmux attach -t '$name'"

  # 关键：用 ssh 先在后台把 tmux 会话建好（已存在就忽略报错）。
  # 不能把 `tmux new-session -d` 放在 et 的远端命令里——et 断开时会把它的进程树一起收走，
  # 实测导致 tmux 会话跟着消失。用 ssh 建好后，会话生命周期就与 et 无关，断线重连才能真正接回。
  ssh "$HOST" "tmux new-session -d -s '$name' 2>/dev/null; true" >/dev/null 2>&1

  # et 在本机 tmux 内不可用（macOS 26 兼容问题），直接用 ssh
  if [ -n "${TMUX:-}" ]; then
    exec ssh -t "$HOST" "$remote_cmd"
  fi

  if command -v et >/dev/null 2>&1; then
    # 先试接回已有 et 会话；没有就新建一个（远端只负责 attach，会话已由上面的 ssh 建好）
    et --attach "$name" || exec et --name "$name" "${ET_USER}@${HOST}" "$remote_cmd"
    exit 0
  fi

  # 没装 et：回退到原来的 ssh 行为
  exec ssh -t "$HOST" "$remote_cmd"
}

cmd="${1:-}"

case "$cmd" in
  tmux)
    shift            # 去掉子命令名，后面才是 tmux 自己的参数
    session=""
    want_recent=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -s|--session)
          session="${2:?-s 后面要跟会话名}"
          shift 2
          ;;
        -a|--attach)
          want_recent=1
          shift
          ;;
        -l|--list)
          ssh -t "$HOST" 'tmux ls' 2>/dev/null || echo "（macmini 上还没有任何 tmux 会话，直接 macmini tmux 就会新建一个）"
          exit $?
          ;;
        -h|--help) usage 0 ;;
        *)
          session="$1"      # 允许省略 -s：macmini tmux dev
          shift
          ;;
      esac
    done

    if [ -n "$session" ]; then
      :                                    # 点名了就接上或新建，不改名字
    elif [ "$want_recent" = 1 ]; then
      session=$(recent_session)
      if [ -z "$session" ]; then
        echo "macmini 上还没有任何 tmux 会话，直接跑 macmini tmux 就会新建一个" >&2
        exit 1
      fi
    else
      session=$(next_name)                 # 不带参数：每次一个新会话
      printf '→ macmini 新会话：%s（下次接回：macmini tmux -s %s，或 macmini tmux -a）\n' \
        "$session" "$session" >&2
    fi

    connect "$session"
    ;;
  ""|-h|--help) usage 0 ;;
  *)
    # 其它命令整体透传到 macmini 执行（$@ 含 cmd 本身，不能再 shift 掉）
    if [ -t 0 ]; then exec ssh -t "$HOST" "$@"; else exec ssh "$HOST" "$@"; fi
    ;;
esac
