#!/usr/bin/env bash
# macmini-tmux —— 操作 macmini 的统一入口
#
# 用法：
#   macmini-tmux              每次开一个新会话，名字自动递增（session#1、session#2 …）
#   macmini-tmux -s <名>      接上该名字的会话；没有就新建（断线重连用这条）
#   macmini-tmux -a           接回最近一次进去过的会话（按最后一次 attach 的时间算）
#   macmini-tmux -l           列出 macmini 上现有的 tmux 会话
#   macmini-tmux <命令...>    把命令透传到 macmini 执行，例如 macmini-tmux df -h
#   macmini-tmux --version    显示当前安装的版本号
#   macmini-tmux --update     从本地仓库拉取最新版并重新安装
#   macmini-tmux -h           显示本帮助
#
#   （`macmini` 是同一脚本的短别名副本，两个名字用法完全一样；
#     涉及 --version / --update 这类含义不清的写法时，推荐用 macmini-tmux。
#     旧写法 `macmini-tmux tmux ...` 仍可用，等价于省略中间那个 tmux。）
#
# 背景：
#   * 传输层用 et（Eternal Terminal）而不是 ssh：et 有**本地回显**——按键先在本地显示、
#     再异步同步给远端，所以 40ms 延迟、250ms 尖峰都不会变成打字卡顿；断网 / 换网络
#     还会自动重连。tmux 仍然在远端跑，负责会话持久化、分屏、状态栏等体验。
#   * et 的 `--name` 每次都新建会话（同名也不接），所以要「先试 --attach 接回、失败再 --name 新建」。
#   * et 在 **本机 tmux 内不可用**（macOS 26 上会报 No route to host，原因未定位），
#     检测到 $TMUX 时自动回退到 ssh，保证在 tmux 里跑这条命令也能用。
#   * ssh 的 -t 负责分配终端，tmux 没有终端会报 "open terminal failed"（回退路径仍需要）。
#   * 远端的 -A 是 tmux 的「有就接上、没有就新建」，所以指定名字时一条命令兼顾首次进入与断线重连。
#   * 不带 -s 时不做「接回」，每次都是新会话：会话名按 session#1、session#2 递增，不用起名也不会撞名。
#   * 会话名里的 # 已经实测可用（本机 tmux 3.6b / macmini tmux 3.3a），不是特殊字符。
#   * macmini 已装好 Ghostty 的 terminfo，TERM=xterm-ghostty 不会再报 missing terminal。
set -u

HOST="${MACMINI_HOST:-mac-mini}"        # 换机器 / 换别名时用环境变量覆盖，如 MACMINI_HOST=mac-mini-lan macmini tmux
ET_USER="${MACMINI_ET_USER:-mac}"       # et 登录用的用户名（et 要写成 user@host）
REPO="${MACMINI_REPO:-$HOME/Developer/macmini-tmux}"   # --update 用的本地仓库路径
PREFIX="session"        # 自动编号会话的前缀，最终名字形如 session#3

# 版本号：与仓库根 VERSION 文件必须一致（install.sh 会校验，不一致就拒绝安装）
VERSION="0.3.3"

usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit "${1:-0}"
}

# 列出 macmini 上的会话名（一个也没有时输出为空）
remote_sessions() {
  ssh "$HOST" "tmux ls -F '#{session_name}'" 2>/dev/null
}

# 算下一个没被占用的名字：从 session#1 开始找，遇到缺口就用那个号
# （比如已有 session#1、session#3，就返回 session#2；删掉的号会被重新利用）
next_name() {
  local n
  n=$(remote_sessions \
        | sed -n "s/^${PREFIX}#\([0-9][0-9]*\)\$/\\1/p" \
        | sort -n \
        | awk 'BEGIN { n = 1 } $1 + 0 == n { n++ } END { print n }')
  printf '%s#%s\n' "$PREFIX" "${n:-1}"
}

# 找「最近一次进去过」的会话：优先看 session_last_attached（最后一次 attach 的时间，
# 也就是你最近一次进这个会话的时刻），从没 attach 过的（-d 在后台建的）才退而看 session_activity
# 注意：会话名里不要用 | 和制表符，否则这里解析会乱
recent_session() {
  ssh "$HOST" "tmux ls -F '#{session_last_attached}|#{session_activity}|#{session_name}'" 2>/dev/null \
    | awk -F'|' 'NF == 3 { print (($1 + 0) > 0 ? $1 : $2) "\t" $3 }' \
    | sort -rn \
    | head -1 \
    | cut -f2-
}

# 连上某个 tmux 会话（et 优先；在 tmux 里或 et 不存在时回退 ssh）
connect() {
  local tmux_name="$1"
  # et 的会话名不允许 # 和空格（会报 Invalid session name），把非法字符换成 -
  # （tmux 会话名本身不变，用户看到/使用的仍然是 session#1 这种）
  local et_name
  et_name=$(printf '%s' "$tmux_name" | tr '# :' '---')

  # 关键：用 ssh 先在后台把 tmux 会话建好（已存在就忽略报错）。
  # 不能把 `tmux new-session -d` 放在 et 的远端命令里——et 断开时会把它的进程树一起收走，
  # 实测导致 tmux 会话跟着消失。用 ssh 建好后，会话生命周期就与 et 无关，断线重连才能真正接回。
  ssh "$HOST" "tmux new-session -d -s '$tmux_name' 2>/dev/null; true" >/dev/null 2>&1

  # et 在本机 tmux 内不可用（macOS 26 兼容问题），直接用 ssh
  if [ -n "${TMUX:-}" ]; then
    exec ssh -t "$HOST" "exec tmux attach -t '$tmux_name'"
  fi

  if command -v et >/dev/null 2>&1; then
    # 直接建新的 et 会话：不再先试 --attach——
    # 它失败时会把服务端所有会话名一股脑列到屏幕上，噪音极大且看不出是否连上。
    # tmux 会话由上面的 ssh 保证存在，所以 et 层每次新建完全不影响「接回同一个工作区」。
    # --disconnect-timeout 让断开后的旧 et 会话 10 分钟后自动过期，不会无限累积。
    exec et --name "$et_name" --disconnect-timeout 10 "${ET_USER}@${HOST}" "exec tmux attach -t '$tmux_name'"
  fi

  # 没装 et：回退到原来的 ssh 行为
  exec ssh -t "$HOST" "exec tmux attach -t '$tmux_name'"
}

# 从本地仓库拉最新版并重新安装
update_self() {
  if [ ! -d "$REPO/.git" ]; then
    echo "找不到本地仓库：$REPO" >&2
    echo "用 MACMINI_REPO=<仓库路径> 指定位置，或先手动 clone：" >&2
    echo "    git clone git@github.com:xhqing/macmini-tmux.git ~/Developer/macmini-tmux" >&2
    exit 1
  fi

  echo "==> 更新仓库：$REPO"
  if ! git -C "$REPO" pull --ff-only; then
    echo "拉取失败：可能有本地未提交改动、或当前不在可快进的提交上" >&2
    echo "先去仓库里处理干净（git status）再重试" >&2
    exit 1
  fi

  "$REPO/install.sh"
  echo
  echo "==> 当前版本：$("$REPO/macmini" --version)"
}

cmd="${1:-}"

# 版本查询与自更新先于其余分支处理，避免被当成「透传到 macmini 的命令」
case "$cmd" in
  --version|-V)
    printf 'macmini-tmux %s\n' "$VERSION"
    exit 0
    ;;
  --update)
    update_self
    exit 0
    ;;
esac

case "$cmd" in
  ""|tmux|-s|--session|-a|--attach|-l|--list|-h|--help)
    # tmux 子命令可以省略：macmini-tmux / macmini-tmux -s dev 直接可用。
    # 旧写法 macmini-tmux tmux ... 仍然支持（等价）。
    [ "$cmd" = "tmux" ] && shift
    session=""
    want_recent=0
    while [ $# -gt 0 ]; do
      case "$1" in
        -s|--session)
          session="${2:?-s 后面要跟会话名}"
          shift 2
          ;;
        -a|--attach)
          want_recent=1
          shift
          ;;
        -l|--list)
          ssh -t "$HOST" 'tmux ls' 2>/dev/null || echo "（macmini 上还没有任何 tmux 会话，直接 macmini-tmux tmux 就会新建一个）"
          exit $?
          ;;
        -h|--help) usage 0 ;;
        *)
          session="$1"      # 允许省略 -s：macmini tmux dev
          shift
          ;;
      esac
    done

    if [ -n "$session" ]; then
      :                                    # 点名了就接上或新建，不改名字
    elif [ "$want_recent" = 1 ]; then
      session=$(recent_session)
      if [ -z "$session" ]; then
        echo "macmini 上还没有任何 tmux 会话，直接跑 macmini-tmux tmux 就会新建一个" >&2
        exit 1
      fi
    else
      session=$(next_name)                 # 不带参数：每次一个新会话
      printf '→ 新会话：%s（下次接回：macmini-tmux tmux -s %s，或 macmini-tmux tmux -a）\n' \
        "$session" "$session" >&2
    fi

    connect "$session"
    ;;
  ""|-h|--help) usage 0 ;;
  *)
    # 其它命令整体透传到 macmini 执行（$@ 含 cmd 本身，不能再 shift 掉）
    if [ -t 0 ]; then exec ssh -t "$HOST" "$@"; else exec ssh "$HOST" "$@"; fi
    ;;
esac
